{
  "rewrites": [
    { "source": "/work", "destination": "/projects.html" },
    { "source": "/about", "destination": "/blogs/blog.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tamara.rocks" }],
      "destination": "https://www.tamara.rocks/$1",
      "permanent": true
    }
  ]
}
